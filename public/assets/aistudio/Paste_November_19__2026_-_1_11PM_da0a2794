  { id: "files", label: "File Intelligence", icon: "▤" },
  { id: "intelligence", label: "Application Intelligence", icon: "⌘" },
  { id: "pipelines", label: "Pipeline Builder", icon: "⇢" },
  { id: "business", label: "Business Intelligence", icon: "◫" },
  { id: "monitoring", label: "System Monitoring", icon: "◉" },
  { id: "reports", label: "Reports & Analytics", icon: "▥" },
  { id: "integrations", label: "Integrations", icon: "⌘" },
  { id: "settings", label: "Settings", icon: "⚙" }
