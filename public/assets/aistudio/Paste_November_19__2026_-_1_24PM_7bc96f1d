// FILE: server/security.ts

import crypto from "node:crypto";
import type { Request, Response, NextFunction } from "express";

const algorithm = "aes-256-gcm";

function encryptionKey(): Buffer {
  const value = process.env.ENCRYPTION_KEY || "";

  if (!/^[a-fA-F0-9]{64}$/.test(value)) {
    throw new Error("A valid 32-byte ENCRYPTION_KEY is required.");
  }

  return Buffer.from(value, "hex");
}

export function encryptSecret(value: string): string {
  const iv = crypto.randomBytes(12);

  const cipher = crypto.createCipheriv(
    algorithm,
    encryptionKey(),
    iv
  );

  const encrypted = Buffer.concat([
    cipher.update(value, "utf8"),
    cipher.final()
  ]);

  const tag = cipher.getAuthTag();

  return [
    iv.toString("hex"),
    tag.toString("hex"),
    encrypted.toString("hex")
  ].join(":");
}

export function decryptSecret(value: string): string {
  const [iv, tag, encrypted] = value.split(":");

  if (!iv || !tag || !encrypted) {
    throw new Error("Invalid encrypted credential.");
  }

  const decipher = crypto.createDecipheriv(
    algorithm,
    encryptionKey(),
    Buffer.from(iv, "hex")
  );

  decipher.setAuthTag(Buffer.from(tag, "hex"));

  return Buffer.concat([
    decipher.update(Buffer.from(encrypted, "hex")),
    decipher.final()
  ]).toString("utf8");
}

export function requireAuthentication(
  req: Request,
  res: Response,
  next: NextFunction
) {
  const authorization = req.headers.authorization;

  if (!authorization?.startsWith("Bearer ")) {
    res.status(401).json({ error: "Authentication required." });
    return;
  }

  const token = authorization.slice(7);

  const expected = process.env.JWT_SECRET;

  if (!expected || !token || !process.env.ADMIN_EMAIL) {
    res.status(503).json({
      error: "Authentication is not configured."
    });
    return;
  }

  const expectedToken = crypto
    .createHmac("sha256", expected)
    .update(process.env.ADMIN_EMAIL)
    .digest("hex");

  const supplied = Buffer.from(token);
  const correct = Buffer.from(expectedToken);

  if (
    supplied.length !== correct.length ||
    !crypto.timingSafeEqual(supplied, correct)
  ) {
    res.status(401).json({ error: "Invalid authentication." });
    return;
  }

  next();
}

export function hashFile(buffer: Buffer): string {
  return crypto.createHash("sha256").update(buffer).digest("hex");
}




// FILE: server/pipeline.ts

import { db } from "./database.js";
import { randomUUID } from "node:crypto";
import { z } from "zod";

const NodeSchema = z.object({
  id: z.string(),
  name: z.string().min(1),
  type: z.enum([
    "trigger",
    "ai",
    "security",
    "approval",
    "processing",
    "notification"
  ]),
  enabled: z.boolean()
});

const PipelineSchema = z.object({
  name: z.string().min(1).max(150),
  nodes: z.array(NodeSchema).min(1).max(100)
});

export async function savePipeline(input: unknown) {
  const pipeline = PipelineSchema.parse(input);

  const id = randomUUID();
  const now = new Date().toISOString();

  db.prepare(`
    INSERT INTO pipelines
    (id, name, definition, status, created_at, updated_at)
    VALUES (?, ?, ?, ?, ?, ?)
  `).run(
    id,
    pipeline.name,
    JSON.stringify(pipeline.nodes),
    "DRAFT",
    now,
    now
  );

  return { id, name: pipeline.name, status: "DRAFT" };
}

export async function executePipeline(id: string, approved: boolean) {
  if (!approved) {
    throw new Error("Explicit pipeline execution approval is required.");
  }

  const pipeline: any = db.prepare(
    "SELECT * FROM pipelines WHERE id = ?"
  ).get(id);

  if (!pipeline) {
    throw new Error("Pipeline not found.");
  }

  const nodes = JSON.parse(pipeline.definition);

  const runId = randomUUID();
  const started = new Date().toISOString();

  db.prepare(`
    INSERT INTO pipeline_runs
    (id, pipeline_id, status, started_at)
    VALUES (?, ?, ?, ?)
  `).run(runId, id, "RUNNING", started);

  const results: any[] = [];

  try {
    for (const node of nodes) {
      if (!node.enabled) continue;

      switch (node.type) {
        case "trigger":
          results.push({
            node: node.id,
            status: "TRIGGER_ACCEPTED"
          });
          break;

        case "security":
          results.push({
            node: node.id,
            status: "SECURITY_CHECK_REQUIRED",
            message: "Connect a configured security inspection provider."
          });
          break;

        case "ai":
          results.push({
            node: node.id,
            status: "AI_PROVIDER_REQUIRED"
          });
          break;

        case "approval":
          throw new Error(
            "A human approval node requires a separate approval action."
          );

        case "processing":
          results.push({
            node: node.id,
            status: "PROCESSOR_NOT_CONFIGURED"
          });
          break;

        case "notification":
          results.push({
            node: node.id,
            status: "NOTIFICATION_PROVIDER_REQUIRED"
          });
          break;
      }
    }

    db.prepare(`
      UPDATE pipeline_runs
      SET status = ?, result = ?, finished_at = ?
      WHERE id = ?
    `).run(
      "COMPLETED_WITH_UNCONFIGURED_STEPS",
      JSON.stringify(results),
      new Date().toISOString(),
      runId
    );

    return { runId, status: "COMPLETED_WITH_UNCONFIGURED_STEPS", results };
  } catch (error: any) {
    db.prepare(`
      UPDATE pipeline_runs
      SET status = ?, result = ?, finished_at = ?
      WHERE id = ?
    `).run(
      "FAILED",
      JSON.stringify({ error: error.message, results }),
      new Date().toISOString(),
      runId
    );

    throw error;
  }
}




// FILE: server/files.ts

import multer from "multer";
import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import pdfParse from "pdf-parse";
import mammoth from "mammoth";
import { db } from "./database.js";
import { hashFile } from "./security.js";

const uploadDirectory =
  process.env.UPLOAD_DIRECTORY || "./storage/uploads";

fs.mkdirSync(uploadDirectory, { recursive: true });

const allowedExtensions = new Set([
  ".pdf", ".docx", ".doc", ".txt",
  ".csv", ".xlsx", ".xls", ".json",
  ".xml", ".html", ".zip", ".png",
  ".jpg", ".jpeg", ".webp", ".js",
  ".ts", ".tsx", ".jsx", ".py",
  ".go", ".java", ".rs", ".cs",
  ".kt", ".scala", ".sql", ".md"
]);

export const upload = multer({
  storage: multer.memoryStorage(),
  limits: {
    fileSize:
      Number(process.env.MAX_FILE_SIZE_MB || 25) * 1024 * 1024,
    files: 20
  },
  fileFilter(_req, file, callback) {
    const ext = path.extname(file.originalname).toLowerCase();

    if (!allowedExtensions.has(ext)) {
      callback(new Error("Unsupported file extension."));
      return;
    }

    callback(null, true);
  }
});

async function extractText(buffer: Buffer, extension: string) {
  switch (extension) {
    case ".pdf": {
      const result = await pdfParse(buffer);
      return result.text;
    }

    case ".docx": {
      const result = await mammoth.extractRawText({ buffer });
      return result.value;
    }

    case ".txt":
    case ".md":
    case ".csv":
    case ".json":
    case ".xml":
    case ".html":
    case ".js":
    case ".ts":
    case ".tsx":
    case ".jsx":
    case ".py":
    case ".go":
    case ".java":
    case ".rs":
    case ".cs":
    case ".kt":
    case ".scala":
    case ".sql":
      return buffer.toString("utf8");

    default:
      return "";
  }
}

export async function analyzeFile(file: Express.Multer.File) {
  const ext = path.extname(file.originalname).toLowerCase();
  const sha256 = hashFile(file.buffer);

  const duplicate = db.prepare(
    "SELECT id FROM files WHERE sha256 = ?"
  ).get(sha256);

  if (duplicate) {
    return {
      filename: file.originalname,
      status: "DUPLICATE",
      duplicate: true
    };
  }

  const id = crypto.randomUUID();

  const destination = path.join(
    uploadDirectory,
    `${id}${ext}`
  );

  fs.writeFileSync(destination, file.buffer, { flag: "wx" });

  try {
    const extracted = await extractText(file.buffer, ext);

    const result = {
      filename: file.originalname,
      status: "PROCESSED",
      charactersExtracted: extracted.length,
      text: extracted.slice(0, 100000),
      analysisRequired: true,
      warnings: ext === ".zip" || ext === ".xlsx" || ext === ".xls" ||
        ext === ".doc" || ext === ".png" || ext === ".jpg" ||
        ext === ".jpeg" || ext === ".webp"
        ? ["A dedicated parser or scanner is required for this format."]
        : []
    };

    db.prepare(`
      INSERT INTO files
      (id, filename, mime_type, size, sha256, status, analysis, created_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?)
    `).run(
      id,
      file.originalname,
      file.mimetype,
      file.size,
      sha256,
      result.status,
      JSON.stringify(result),
      new Date().toISOString()
    );

    return result;
  } catch (error) {
    fs.rmSync(destination, { force: true });
    throw error;
  }
}




// FILE: server/integrations.ts

import { google } from "googleapis";
import { db } from "./database.js";
import { encryptSecret } from "./security.js";

const googleOAuth = new google.auth.OAuth2(
  process.env.GOOGLE_CLIENT_ID,
  process.env.GOOGLE_CLIENT_SECRET,
  process.env.GOOGLE_REDIRECT_URI
);

export function authorizationUrl(provider: string) {
  if (provider === "gmail") {
    if (!process.env.GOOGLE_CLIENT_ID ||
        !process.env.GOOGLE_CLIENT_SECRET) {
      throw new Error("Gmail OAuth credentials are missing.");
    }

    return googleOAuth.generateAuthUrl({
      access_type: "offline",
      prompt: "consent",
      scope: [
        "openid",
        "email",
        "https://www.googleapis.com/auth/gmail.readonly"
      ]
    });
  }

  if (provider === "microsoft") {
    const clientId = process.env.MICROSOFT_CLIENT_ID;

    if (!clientId || !process.env.MICROSOFT_CLIENT_SECRET) {
      throw new Error("Microsoft OAuth credentials are missing.");
    }

    const tenant = process.env.MICROSOFT_TENANT_ID || "common";

    const params = new URLSearchParams({
      client_id: clientId,
      response_type: "code",
      redirect_uri: process.env.MICROSOFT_REDIRECT_URI || "",
      response_mode: "query",
      scope: "openid profile offline_access User.Read Mail.Read",
      state: crypto.randomUUID()
    });

    return `https://login.microsoftonline.com/${tenant}/oauth2/v2.0/authorize?${params}`;
  }

  throw new Error("Unsupported integration.");
}

export async function saveGmailAuthorization(code: string) {
  const { tokens } = await googleOAuth.getToken(code);

  if (!tokens.refresh_token && !tokens.access_token) {
    throw new Error("OAuth returned no usable token.");
  }

  const credential = JSON.stringify(tokens);

  db.prepare(`
    INSERT INTO integrations
    (id, provider, status, encrypted_token, created_at, updated_at)
    VALUES (?, ?, ?, ?, ?, ?)
    ON CONFLICT(provider) DO UPDATE SET
    status = excluded.status,
    encrypted_token = excluded.encrypted_token,
    updated_at = excluded.updated_at
  `).run(
    crypto.randomUUID(),
    "gmail",
    "connected",
    encryptSecret(credential),
    new Date().toISOString(),
    new Date().toISOString()
  );
}

