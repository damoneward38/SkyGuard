async function apiRequest<T>(path: string, options: RequestInit = {}): Promise<T> {
  const response = await fetch(`${API}${path}`, {
    ...options,
    headers: {
      ...(options.body instanceof FormData ? {} : { "Content-Type": "application/json" }),
      ...options.headers
    },
    credentials: "include"
  });
  if (!response.ok) {
    throw new Error(`Server error ${response.status}: ${await response.text()}`);
  }
  return response.json();
}

function Metric({ label, value, note }: { label: string; value: string; note: string }) {
  return <div className="metric">
    <div className="metric-label">{label}</div>
    <div className="metric-value">{value}</div>
    <div className="metric-note">{note}</div>
  </div>;
}

export default function SkyGuard() {
  const [page, setPage] = useState<Page>("command");
  const [collapsed, setCollapsed] = useState(false);
  const [messages, setMessages] = useState<{ role: string; content: string }[]>([
    { role: "assistant", content: "SkyGuard Business Intelligence Assistant initialized. Connect your authorized business data sources or upload documents to begin." }
  ]);
  const [prompt, setPrompt] = useState("");
  const [busy, setBusy] = useState(false);
  const [files, setFiles] = useState<File[]>([]);
  const [fileResults, setFileResults] = useState<any[]>([]);
  const [findings, setFindings] = useState<Finding[]>([]);
  const [nodes, setNodes] = useState<PipelineNode[]>([
    { id: "1", name: "Incoming Event", type: "trigger", enabled: true },
    { id: "2", name: "AI Analysis", type: "ai", enabled: true },
    { id: "3", name: "Security Inspection", type: "security", enabled: true },
    { id: "4", name: "Human Approval", type: "approval", enabled: true }
  ]);
  const [health, setHealth] = useState<any>(null);
  const [integrations, setIntegrations] = useState<any[]>([]);
  const [error, setError] = useState("");
  const [listening, setListening] = useState(false);
  const [speaking, setSpeaking] = useState(false);
  const [selectedFiles, setSelectedFiles] = useState<File[]>([]);
  const recognition = useRef<any>(null);
  const chatEnd = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const style = document.createElement("style");
    style.textContent = styles;
    document.head.appendChild(style);
    return () => style.remove();
  }, []);

  useEffect(() => {
    chatEnd.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages]);

  useEffect(() => {
    refreshHealth();
    refreshIntegrations();
    refreshFindings();
  }, []);

  async function refreshHealth() {
    try {
      setHealth(await apiRequest("/health"));
    } catch {
      setHealth({ status: "BACKEND NOT CONNECTED" });
    }
  }

  async function refreshIntegrations() {
    try {
      const result = await apiRequest<any>("/integrations");
      setIntegrations(result.integrations || []);
    } catch {
      setIntegrations([]);
    }
  }

  async function refreshFindings() {
    try {
      const result = await apiRequest<any>("/security/findings");
      setFindings(result.findings || []);
    } catch {
      setFindings([]);
    }
  }

  async function sendMessage() {
    if (!prompt.trim() || busy) return;
    const question = prompt.trim();
    setPrompt("");
    setMessages(prev => [...prev, { role: "user", content: question }]);
    setBusy(true);
    setError("");
    try {
      const result = await apiRequest<any>("/assistant/chat", {
        method: "POST",
        body: JSON.stringify({
          message: question,
          history: messages.slice(-20)
        })
      });
      setMessages(prev => [...prev, {
        role: "assistant",
        content: result.response || "The AI service returned no response."
      }]);
    } catch (e: any) {
      setError(e.message);
      setMessages(prev => [...prev, {
        role: "assistant",
        content: "The AI backend is not connected. Configure the server-side AI provider before using business intelligence."
      }]);
    } finally {
      setBusy(false);
    }
  }

  function startVoice() {
    const SpeechRecognition =
      (window as any).SpeechRecognition ||
      (window as any).webkitSpeechRecognition;
    if (!SpeechRecognition) {
      setError("Speech recognition is not supported in this browser.");
      return;
    }
    if (listening) {
      recognition.current?.stop();
      setListening(false);
      return;
    }
    const instance = new SpeechRecognition();
    instance.lang = navigator.language || "en-US";
    instance.continuous = false;
    instance.interimResults = false;
    instance.onresult = (event: any) => {
      setPrompt(prev => `${prev} ${event.results[0][0].transcript}`.trim());
    };
    instance.onerror = () => {
      setError("Microphone recognition failed. Check microphone permissions.");
      setListening(false);
    };
    instance.onend = () => setListening(false);
    recognition.current = instance;
    instance.start();
    setListening(true);
  }

  function speak(text: string) {
    if (!("speechSynthesis" in window)) {
      setError("Speech synthesis is unavailable in this browser.");
      return;
    }
    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.onstart = () => setSpeaking(true);
    utterance.onend = () => setSpeaking(false);
    utterance.onerror = () => setSpeaking(false);
    window.speechSynthesis.speak(utterance);
  }

  function stopSpeaking() {
    window.speechSynthesis?.cancel();
    setSpeaking(false);
  }

  async function uploadFiles() {
    if (!files.length) return;
    setBusy(true);
    setError("");
    try {
      const data = new FormData();
      files.forEach(file => data.append("files", file));
      const result = await apiRequest<any>("/files/analyze", {
        method: "POST",
        body: data
      });
      setFileResults(result.results || []);
      setFiles([]);
    } catch (e: any) {
      setError(e.message);
    } finally {
      setBusy(false);
    }
  }

  async function createPipeline() {
    try {
      const result = await apiRequest<any>("/pipelines", {
        method: "POST",
        body: JSON.stringify({ name: "Business Protection Workflow", nodes })
      });
      alert(`Pipeline saved: ${result.id || result.name}`);
    } catch (e: any) {
      setError(e.message);
    }
  }

  async function connectIntegration(provider: string) {
    try {
      const result = await apiRequest<any>(`/integrations/${provider}/authorize`);
      if (result.authorizationUrl) {
        window.location.assign(result.authorizationUrl);
      } else {
        setError("The backend did not provide an authorization URL.");
      }
    } catch (e: any) {
      setError(e.message);
    }
  }

  async function loadApplicationInventory() {
    try {
      const result = await apiRequest<any>("/application/inventory", { method: "POST" });
      alert(`Inventory scan completed. Components discovered: ${result.componentCount ?? "See report"}`);
    } catch (e: any) {
      setError(e.message);
    }
  }

  function addNode() {
    setNodes(prev => [...prev, {
      id: crypto.randomUUID(),
      name: "New Processing Step",
      type: "processing",
      enabled: true
    }]);
  }

  function updateNode(id: string, changes: Partial<PipelineNode>) {
    setNodes(prev => prev.map(node => node.id === id ? { ...node, ...changes } : node));
  }

  function renderCommand() {
    return <>
      <div className="grid">
        <Metric label="SECURITY FINDINGS" value={String(findings.length)} note="Findings returned by connected backend" />
        <Metric label="INTEGRATIONS" value={String(integrations.filter(x => x.status === "connected").length)} note="Verified connected integrations" />
        <Metric label="FILES ANALYZED" value={String(fileResults.length)} note="Current analysis results" />
        <Metric label="SYSTEM STATUS" value={health?.status || "CHECKING"} note="Backend health response" />
      </div>
      <div className="panel">
        <h3>Executive Intelligence Briefing</h3>
        <p className="muted">Review verified business intelligence, security findings, operational health, and outstanding actions. Connect your data sources to populate this briefing.</p>
        <button className="btn primary" onClick={() => setPage("assistant")}>Open AI Business Assistant</button>
        <button className="btn" onClick={refreshHealth}>Refresh Health</button>
      </div>
      <div className="section-title">Security Findings</div>
      {renderFindings()}
    </>;
  }

  function renderFindings() {
    if (!findings.length) return <div className="panel empty">No findings returned. This does not establish that the system is threat-free. Connect security monitoring sources.</div>;
    return <div className="finding-list">{findings.map(f => <div className="finding" key={f.id}>
      <div className="row"><strong>{f.title}</strong><span className={`pill ${f.severity.toLowerCase()}`}>{f.severity}</span></div>
      <p className="muted">{f.description}</p>
      <div className="muted">Source: {f.source} · Status: {f.status}</div>
    </div>)}</div>;
  }

  function renderAssistant() {
    return <>
      <div className="chat">
        {messages.map((m, i) => <div className={`message ${m.role}`} key={i}>
          {m.content}
          {m.role === "assistant" && <div style={{ marginTop: 9 }}>
            <button className="btn" onClick={() => speak(m.content)}>▶ Listen</button>
          </div>}
        </div>)}
        <div ref={chatEnd} />
      </div>
      <div className="chat-controls">
        <button className="btn" onClick={startVoice}>{listening ? "■ Stop Mic" : "🎙 Mic"}</button>
        <input className="input" value={prompt} onChange={e => setPrompt(e.target.value)} onKeyDown={e => e.key === "Enter" && sendMessage()} placeholder="Ask SkyGuard about your business..." />
        <button className="btn primary" disabled={busy} onClick={sendMessage}>{busy ? "..." : "Send"}</button>
        <button className="btn" onClick={stopSpeaking}>Stop Audio</button>
      </div>
    </>;
  }

  function renderFiles() {
    return <>
      <div className="panel">
        <h3>Secure Document Intelligence</h3>
        <p className="muted">Upload business documents, source code, spreadsheets, and reports for server-side analysis.</p>
        <input type="file" multiple className="input" accept=".pdf,.doc,.docx,.txt,.csv,.xlsx,.xls,.json,.xml,.html,.zip,.png,.jpg,.jpeg,.webp,.js,.ts,.tsx,.py,.go,.java,.rs,.cs" onChange={e => setFiles(Array.from(e.target.files || []))} />
        <p className="muted">{files.length} files selected</p>
        <button className="btn primary" disabled={!files.length || busy} onClick={uploadFiles}>Analyze Files</button>
      </div>
      <div className="section-title">Analysis Results</div>
      {fileResults.length ? <div className="file-list">{fileResults.map((r, i) => <div className="file-item" key={i}>
        <strong>{r.filename}</strong>
        <p className="muted">{r.summary || r.error || "Analysis completed."}</p>
        <pre style={{ whiteSpace: "pre-wrap", fontSize: 11 }}>{JSON.stringify(r.findings || [], null, 2)}</pre>
      </div>)}</div> : <div className="panel empty">No files analyzed yet.</div>}
    </>;
  }

  function renderPipeline() {
    return <>
      <div className="panel">
        <div className="row"><h3>Workflow Designer</h3><button className="btn" onClick={addNode}>+ Add Node</button></div>
        <p className="muted">Configure workflow stages. Save only after reviewing the pipeline and its permissions.</p>
        <div className="node-list">{nodes.map((node, index) => <div className="pipeline-node" key={node.id}>
          <div style={{ flex: 1 }}>
            <div className="muted">STEP {index + 1} · {node.type.toUpperCase()}</div>
            <input className="input" value={node.name} onChange={e => updateNode(node.id, { name: e.target.value })} />
          </div>
          <label className="muted"><input type="checkbox" checked={node.enabled} onChange={e => updateNode(node.id, { enabled: e.target.checked })} /> Enabled</label>
          <button className="btn danger" onClick={() => setNodes(prev => prev.filter(n => n.id !== node.id))}>×</button>
        </div>)}</div>
        <button className="btn primary" style={{ marginTop: 18 }} onClick={createPipeline}>Save Pipeline</button>
      </div>
    </>;
  }

  function renderIntelligence() {
    return <div className="panel">
      <h3>Application Discovery Engine</h3>
      <p className="muted">Inspect the authorized application repository and connected services. The backend must perform actual filesystem, source-code, route, dependency, and integration discovery.</p>
      <button className="btn primary" onClick={loadApplicationInventory}>Run Application Inventory</button>
      <div className="section-title">Verification Standards</div>
      {["VERIFIED", "PARTIALLY VERIFIED", "UNVERIFIED", "FAILED", "NOT CONFIGURED"].map(x => <div className="finding" key={x}>{x}</div>)}
    </div>;
  }

  function renderIntegrations() {
    return <div className="stack">
      {["gmail", "microsoft"].map(provider => <div className="panel row" key={provider}>
        <div><h3>{provider === "gmail" ? "Google Gmail" : "Microsoft Outlook"}</h3><p className="muted">OAuth authorization and email security integration</p></div>
        <button className="btn primary" onClick={() => connectIntegration(provider)}>Connect</button>
      </div>)}
      {integrations.map((item, i) => <div className="panel row" key={i}>
        <strong>{item.name || item.provider}</strong>
        <span className="pill">{item.status}</span>
      </div>)}
    </div>;
  }

  function renderMonitoring() {
    return <div className="panel">
      <div className="row"><h3>System Health</h3><button className="btn" onClick={refreshHealth}>Refresh</button></div>
      <pre style={{ whiteSpace: "pre-wrap", fontSize: 12 }}>{JSON.stringify(health, null, 2)}</pre>
      <p className="muted">Only backend health checks and verified telemetry should populate this view.</p>
    </div>;
  }

  function renderBusiness() {
    return <div className="panel">
      <h3>Business Intelligence</h3>
      <p className="muted">Analyze operational performance, business documents, costs, workflows, and opportunities using authorized connected business data.</p>
      <button className="btn primary" onClick={() => setPage("assistant")}>Ask AI to Analyze Business</button>
    </div>;
  }

  function renderReports() {
    return <div className="panel">
      <h3>Security & Business Reports</h3>
      <p className="muted">Generate reports from verified findings and actual operational data.</p>
      <button className="btn" onClick={refreshFindings}>Refresh Findings</button>
      <button className="btn" onClick={() => {
        const blob = new Blob([JSON.stringify({ generatedAt: new Date().toISOString(), findings, fileResults, health }, null, 2)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "skyguard-report.json";
        a.click();
        URL.revokeObjectURL(url);
      }}>Export Current Data</button>
    </div>;
  }

  function renderSettings() {
    return <div className="panel">
      <h3>Security Configuration</h3>
      <p className="muted">Authentication, authorization, token storage, encryption, data retention, and audit configuration must be enforced by the backend.</p>
      <button className="btn" onClick={refreshHealth}>Check Backend</button>
    </div>;
  }

  const pageInfo: Record<Page, { title: string; description: string }> = {
    command: { title: "Executive Command Center", description: "Business protection, intelligence, and operational oversight." },
    assistant: { title: "AI Business Assistant", description: "Your intelligent business and security operations assistant." },
    email: { title: "Email Protection Center", description: "Secure business communications and investigate suspicious messages." },
    threats: { title: "Threat Intelligence", description: "Investigate verified security findings and emerging threats." },
    files: { title: "File Intelligence", description: "Upload, analyze, understand, and improve business documents and code." },
    intelligence: { title: "Application Intelligence", description: "Discover application architecture, dependencies, and operational relationships." },
    pipelines: { title: "Automated Pipeline Builder", description: "Design, inspect, and manage business automation workflows." },
    business: { title: "Business Intelligence", description: "Understand operations and prioritize business improvements." },
    monitoring: { title: "System Health Monitoring", description: "Inspect live service health and connected infrastructure." },
    reports: { title: "Reports & Analytics", description: "Export findings and review verified business intelligence." },
    integrations: { title: "Integrations & Connections", description: "Authorize and manage external business services." },
    settings: { title: "Settings & Security", description: "Configure application security and operational preferences." }
  };

  function renderPage() {
    switch (page) {
      case "command": return renderCommand();
      case "assistant": return renderAssistant();
      case "files": return renderFiles();
      case "pipelines": return renderPipeline();
      case "intelligence": return renderIntelligence();
      case "integrations": return renderIntegrations();
      case "monitoring": return renderMonitoring();
      case "business": return renderBusiness();
      case "reports": return renderReports();
      case "email": return <div className="panel"><h3>Email Protection</h3><p className="muted">Connect Gmail or Microsoft Outlook to enable authorized email analysis, phishing detection, sender verification, and incident investigation.</p><button className="btn primary" onClick={() => setPage("integrations")}>Configure Email Connection</button></div>;
      case "threats": return renderFindings();
      case "settings": return renderSettings();
      default: return renderCommand();
    }
  }

  return <div className="app">
    <aside className="sidebar" style={collapsed ? { width: 76 } : undefined}>
      <div className="brand">SKY<span>GUARD</span></div>
      {!collapsed && <div className="tagline">BUSINESS PROTECTION INTELLIGENCE</div>}
      <button className="btn" style={{ marginBottom: 15 }} onClick={() => setCollapsed(!collapsed)}>{collapsed ? "»" : "« Collapse Navigation"}</button>
      <nav className="nav">
        {navigation.map(item => <button key={item.id} className={page === item.id ? "active" : ""} onClick={() => setPage(item.id)} title={item.label}>
          <span className="navicon">{item.icon}</span>{!collapsed && item.label}
        </button>)}
      </nav>
      {!collapsed && <div className="sidebar-bottom">
        <div>SKYGUARD ENTERPRISE</div>
        <div style={{ marginTop: 7 }}>Business first. Security always.</div>
      </div>}
    </aside>

    <main className="main">
      <header className="topbar">
        <div>
          <div className="eyebrow">SKYGUARD / ENTERPRISE</div>
          <h1>{pageInfo[page].title}</h1>
          <div className="subtitle">{pageInfo[page].description}</div>
        </div>
        <div className="status">{health?.status || "BACKEND STATUS UNKNOWN"}</div>
      </header>

      {error && <div className="panel" style={{ borderColor: "#813b4a", marginBottom: 15 }}>
        <div className="row"><span style={{ color: "#ff9eae" }}>{error}</span><button className="btn" onClick={() => setError("")}>Dismiss</button></div>
      </div>}

      {renderPage()}

      <div className="footer-note">SkyGuard · Evidence-based business protection · Authorized operations only</div>
    </main>
  </div>;
}
